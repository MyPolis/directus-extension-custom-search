{
	"name": "@mypolis.eu/directus-extension-custom-search",
	"description": "Override the Directus internal search system with a custom search filter - supports relationships",
	"icon": "extension",
	"version": "0.3.1",
	"license": "MIT",
	"contributors": [
		{
			"name": "Guilherme Rosado",
			"email": "guilherme.rosado@mypolis.eu"
		}
	],
	"repository": {
		"type": "git",
		"url": "github:mypolis/directus-extension-custom-search"
	},
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-bundle"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "bundle",
		"sandbox": {
			"enabled": true,
			"requestedScopes": {}
		},
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "hook",
				"name": "intercept-search",
				"source": "src/intercept-search/index.ts"
			},
			{
				"type": "interface",
				"name": "search-configuration",
				"source": "src/search-configuration/index.ts"
			}
		],
		"host": "^10.10.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"add": "directus-extension add",
		"typecheck": "tsc --noEmit",
		"test": "node --import=tsx --test \"src/**/*.test.ts\"",
		"format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,astro,json,css,md}\""
	},
	"devDependencies": {
		"@directus/extensions-sdk": "^17.1.3",
		"@tsconfig/node24": "^24.0.4",
		"@types/node": "^24.1.0",
		"prettier": "^3.8.3",
		"tsx": "^4.19.0",
		"typescript": "^5.9.3",
		"vue": "^3.5.28"
	}
}
